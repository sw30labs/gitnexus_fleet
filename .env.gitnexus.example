# Required: GitHub Personal Access Token (needs repo scope)
GITHUB_TOKEN=ghp_your_github_token_here

# Optional: Enables the "Ask" natural language query feature and cloud embeddings (text-embedding-3)
# Without this, all other features still work; embeddings fall back to local snowflake-arctic-embed-xs
OPENAI_API_KEY=sk-your_openai_key_here
